{
  "name": "foundry-creature-ai",
  "version": "0.53.0",
  "private": true,
  "type": "module",
  "description": "PF2e creature AI with shared tactical plans, behavior components, native rules and a basic NPC fallback",
  "scripts": {
    "test": "node tools/build-module.mjs && node tools/run-tests.mjs",
    "test:serial": "node tools/build-module.mjs && node tools/run-tests.mjs --jobs 1",
    "test:combat": "node --test test/combat-lab.test.mjs",
    "simulate": "node tools/run-combat-lab.mjs",
    "view:combat": "node tools/serve-combat-lab.mjs",
    "demo": "node examples/decide.mjs",
    "build": "node tools/build-module.mjs"
  },
  "engines": { "node": ">=20" }
}
